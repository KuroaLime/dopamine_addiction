# Visual Studio / Rider / IDE 관련
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 언리얼 엔진 생성 폴더 (핵심)
**/Binaries/*
**/Plugins/*/Binaries/*
**/Intermediate/*
**/Plugins/*/Intermediate/*
**/Saved/*
**/DerivedDataCache/*
**/Build/*

# 빌드 및 라이브러리 파일
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# 프로젝트 파일 (Xcode 포함)
*.xcodeproj
*.xcworkspace

# 맵 빌드 데이터
**/_BuiltData.uasset

# 소스 아트 및 에셋 (용량 관리용)
**/SourceArt/**/*.png
**/SourceArt/**/*.tga

# OS 관련 정크 파일
.DS_Store
Thumbs.db

# 사용자 추가 설정: 배치 파일
*.bat

# Build 폴더 내 예외 처리 (아이콘 및 블랙리스트 유지)
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# =========================================================
# Dedicated Server build output to share
# =========================================================

# Unreal 전체 Binaries는 기본적으로 무시하지만,
# Manager Dedicated Server 실행 파일만 예외 허용
!Project/Manager/Binaries/
!Project/Manager/Binaries/Win64/
!Project/Manager/Binaries/Win64/ManagerServer.exe
!Project/Manager/Binaries/Win64/ManagerServer.target
!Project/Manager/Binaries/Win64/ManagerServer.modules

# 필요할 때만 사용: 서버 디버깅 심볼
# !Project/Manager/Binaries/Win64/ManagerServer.pdb